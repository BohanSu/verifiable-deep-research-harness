# Qwen, GPT and DeepSeek share one OpenAI-compatible gateway.
DR_MODEL_PROVIDER=openai_compatible
DR_DEFAULT_MODEL=deepseek
DR_DEFAULT_PROFILE=team
# `openalex` is free scholarly discovery and needs no key. `duckduckgo` is a
# keyless development fallback, `brave` requires the optional key below, and
# `replay` is offline.
DR_SEARCH_PROVIDER=openalex
# Opt in only when a local TUN proxy maps public HTTPS domains to RFC 2544
# Fake-IP addresses (198.18.0.0/15). Literal IPs and HTTP remain blocked.
DR_ALLOW_RFC2544_PROXY_FAKE_IP=false

# Team profile role routes. Critic is intentionally a local deterministic gate.
DR_PERCEPTION_MODEL=gpt
DR_PLANNER_MODEL=gpt
DR_SCOUT_MODEL=deepseek
DR_CURATOR_MODEL=deepseek
DR_WRITER_MODEL=gpt
DR_VERIFIER_MODEL=qwen

MODEL_API_KEY=
MODEL_BASE_URL=
DR_BRAVE_API_KEY=
# Bound long model generations without automatically replaying uncertain calls.
DR_MODEL_TIMEOUT_SECONDS=180
QWEN_MODEL=
GPT_MODEL=
DEEPSEEK_MODEL=
DR_MODEL_PRICING_FILE=config/model-pricing.json

# Automatic evidence recovery uses the total ceilings but leaves this small
# tranche for one explicit operator-approved resume.
DR_MANUAL_RESUME_RESERVE_ITERATIONS=1
DR_MANUAL_RESUME_RESERVE_SEARCH_CALLS=2
DR_MANUAL_RESUME_RESERVE_PAGES=3

# Operator-declared capabilities. Keep audio disabled until the exact gateway
# and model ID have passed a native input_audio probe.
DR_MODEL_CAPABILITY_RECEIPT=conformance/model-capability-verification.json
QWEN_MODALITIES=text,document
GPT_MODALITIES=text,document,image
DEEPSEEK_MODALITIES=text,document

DR_CACHE_DIR=.cache/deep-research
DR_MODEL_INPUT_USD_PER_M=0
DR_MODEL_OUTPUT_USD_PER_M=0
